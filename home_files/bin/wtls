#!/usr/bin/env bash
set -euo pipefail

NAME="${1:-}"
BASE="${2:-main}"

if [[ -z "$NAME" ]]; then
  echo "Usage: $(basename "$0") <name> [base-ref]" >&2
  exit 2
fi

ROOT="$(git rev-parse --show-toplevel)"
WT_DIR="$ROOT/.worktrees"
PATH_DIR="$WT_DIR/$NAME"

mkdir -p "$WT_DIR"

if [[ -e "$PATH_DIR" ]]; then
  if git -C "$ROOT" worktree list --porcelain | grep -F -x "worktree $PATH_DIR" >/dev/null; then
    pushd "$PATH_DIR"
    exit 0
  fi
  echo "Error: $PATH_DIR already exists (and doesn't look like a worktree)." >&2
  exit 1
fi

if git rev-parse -q --verify "$NAME^{commit}" >/dev/null; then
  git -C "$ROOT" worktree add "$PATH_DIR" "$NAME"
else
  git -C "$ROOT" worktree add -b "$NAME" "$PATH_DIR" "$BASE"
fi

pushd "$PATH_DIR"
